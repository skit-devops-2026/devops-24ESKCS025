# Public client configuration for a local development setup.
# Copy this file to .env and replace every value with your Supabase project values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_PROJECT_ID=your-project-id

# MERN Stack Backend Configuration
VITE_MERN_API_URL=http://localhost:5000/api
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hostelfix?retryWrites=true&w=majority
PORT=5000

